{
  // Local MCP server configuration for Agent Reviewer.
  //
  // Runs the MCP server locally via stdio, communicating directly
  // with GitHub Copilot in VS Code.
  //
  // The agent reviewer uses the Copilot provider (via `gh auth token`)
  // so no extra API key is needed.
  "servers": {
    "agent-reviewer": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "src.mcp_server"],
      "cwd": "${workspaceFolder}"
    }
  }
}


